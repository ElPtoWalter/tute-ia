{
  "name": "sala-cero",
  "version": "27.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "type": "module",
  "scripts": {
    "test": "pnpm run test:static && pnpm run test:unit && pnpm run test:e2e",
    "test:unit": "node tests/unit/roulette.test.mjs",
    "test:static": "node scripts/validate.mjs",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
