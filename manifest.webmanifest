{
  "id": "./?source=pwa",
  "name": "Tute IA — Club offline",
  "short_name": "Tute IA",
  "description": "Tute offline contra IA y multijugador local pasa el móvil para 2, 3 o 4 personas, con tutoriales, reglas de casa, guardado automático y música.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#04110e",
  "theme_color": "#071c17",
  "lang": "es-ES",
  "dir": "ltr",
  "categories": [
    "games",
    "entertainment",
    "education"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "icons": [
